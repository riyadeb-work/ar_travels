            <i class="fab fa-whatsapp text-xl"></i>
            <span>Confirm Booking</span>
          </button>
        </div>
        <p class="text-[10px] text-center text-slate-400">Secure booking via WhatsApp • No payment required now</p>
      </form>
    </div>
  </div>
</div>

