<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>A R Travels | Premium Car Rental & Driver Services</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts: Outfit (Headings) & Inter (Body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Outfit:wght@300;500;700;800&display=swap" rel="stylesheet">

  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Configuration & Custom Styles -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#F7C600',   /* Yellow - Main Action Color */
            primaryDark: '#D4AA00', /* Darker Yellow - Hover State */
            secondary: '#00273D', /* Dark Blue - Headings/Footer */
            accent: '#F7C600',    /* Alias for Primary */
            light: '#F8FAFC',     /* Slate-50 - Clean Background */
            surface: '#FFFFFF',
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            heading: ['Outfit', 'sans-serif'],
          },
          boxShadow: {
            'soft': '0 20px 40px -15px rgba(0, 39, 61, 0.1)',
            'glow': '0 0 20px rgba(247, 198, 0, 0.4)',
          }
        }
      }
    }
  </script>

  <style>
    /* Base Styles */
    body {
      font-family: 'Inter', sans-serif;
      background-color: #F8FAFC;
      overflow-x: hidden; /* Fix horizontal scroll */
      width: 100%;
      color: #334155;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: 'Outfit', sans-serif;
    }

    /* Glassmorphism Utilities */
    .glass {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(0, 39, 61, 0.1);
    }

    /* Hero Carousel Transitions */
    .slide {
      transition: transform 1.2s cubic-bezier(0.25, 1, 0.5, 1), opacity 1.2s ease;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      z-index: 10;
      transform: scale(1.1);
    }
    .slide.active {
      opacity: 1;
      z-index: 20;
      transform: scale(1);
    }

    /* Parallax */
    .parallax {
      background-attachment: fixed;
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
    }

    /* Footer Animation (Updated Colors) */
    .footer-road-scene {
      position: relative;
      height: 140px;
      width: 100%;
      background-color: #00273D;
      overflow: hidden;
      border-top: 4px solid #F7C600;
    }

    .road-line {
      position: absolute;
      bottom: 30px;
      width: 100%;
      height: 4px;
      background-image: linear-gradient(90deg, #64748B 50%, transparent 50%);
      background-size: 120px 100%;
      animation: moveRoad 1.5s linear infinite;
    }

    @keyframes moveRoad {
      0% { background-position: 0 0; }
      100% { background-position: -120px 0; }
    }

    .animated-car {
      position: absolute;
      bottom: 35px;
      width: 120px;
      height: 45px;
      z-index: 10;
      filter: drop-shadow(0 10px 10px rgba(0,0,0,0.5));
    }

    .car-1 { left: -150px; animation: driveCar 7s linear infinite; }
    .car-2 { left: -150px; animation: driveCar 10s linear infinite 3.5s; }

    @keyframes driveCar {
      0% { transform: translateX(-200px); }
      100% { transform: translateX(100vw); }
    }

    /* Traffic Light */
    .traffic-light {
      position: absolute;
      right: 8%;
      bottom: 90px;
      width: 40px;
      height: 100px;
      background: #001f30;
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-around;
      padding: 8px 0;
      border: 2px solid #334155;
      z-index: 5;
      box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    }
    .light { width: 20px; height: 20px; border-radius: 50%; opacity: 0.2; transition: opacity 0.3s; }
    .red { background-color: #EF4444; animation: lightRed 8s infinite; box-shadow: 0 0 15px #EF4444; }
    .yellow { background-color: #F7C600; animation: lightYellow 8s infinite; box-shadow: 0 0 15px #F7C600; }
    .green { background-color: #10B981; animation: lightGreen 8s infinite; box-shadow: 0 0 15px #10B981; }

    @keyframes lightRed { 0%, 40% { opacity: 1; } 41%, 100% { opacity: 0.2; } }
    @keyframes lightYellow { 0%, 40% { opacity: 0.2; } 41%, 55% { opacity: 1; } 56%, 100% { opacity: 0.2; } }
    @keyframes lightGreen { 0%, 55% { opacity: 0.2; } 56%, 95% { opacity: 1; } 96%, 100% { opacity: 0.2; } }

    /* Floating Button Pulse */
    .pulse-animation {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
      animation: pulse-green 2s infinite;
    }
    @keyframes pulse-green {
      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
      70% { transform: scale(1); box-shadow: 0 0 0 15px rgba(34, 197, 94, 0); }
      100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
    }

    /* Modal Animation - Updated for Flexbox Centering */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
      animation: fadeInUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Navigation Arrows */
    .nav-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 30;
      color: white;
      font-size: 2rem;
      background: rgba(0, 39, 61, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.2);
      width: 50px;
      height: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      cursor: pointer;
      transition: all 0.3s ease;
      backdrop-filter: blur(4px);
    }
    .nav-arrow:hover {
      background: #F7C600;
      color: #00273D;
    }
    .nav-arrow.prev { left: 20px; }
    .nav-arrow.next { right: 20px; }

    /* Custom Scrollbar for Modal */
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.05);
      margin: 10px 0; /* Add margin to top/bottom of track */
      border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #F7C600; /* Primary Color */
      border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #D4AA00; /* Primary Dark */
    }

    /* Fade In On Scroll */
    .fade-in-section {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.8s ease-out, transform 0.8s ease-out;
      will-change: opacity, visibility;
    }
    .fade-in-section.is-visible {
      opacity: 1;
      transform: none;
    }
  </style>
</head>
<body class="text-slate-700 antialiased selection:bg-primary selection:text-secondary">

<!-- 1. Header (Glassmorphism) -->
