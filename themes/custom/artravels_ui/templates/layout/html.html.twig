<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>A R Travels | Premium Car Rental & Driver Services</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts: Outfit (Headings) & Inter (Body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Outfit:wght@300;500;700;800&display=swap" rel="stylesheet">

  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Configuration & Custom Styles -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#F7C600',   /* Yellow - Main Action Color */
            primaryDark: '#D4AA00', /* Darker Yellow - Hover State */
            secondary: '#00273D', /* Dark Blue - Headings/Footer */
            accent: '#F7C600',    /* Alias for Primary */
            light: '#F8FAFC',     /* Slate-50 - Clean Background */
            surface: '#FFFFFF',
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            heading: ['Outfit', 'sans-serif'],
          },
          boxShadow: {
            'soft': '0 20px 40px -15px rgba(0, 39, 61, 0.1)',
            'glow': '0 0 20px rgba(247, 198, 0, 0.4)',
          }
        }
      }
    }
  </script>

  <style>
    /* Base Styles */
    body {
      font-family: 'Inter', sans-serif;
      background-color: #F8FAFC;
      overflow-x: hidden; /* Fix horizontal scroll */
      width: 100%;
      color: #334155;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: 'Outfit', sans-serif;
    }

    /* Glassmorphism Utilities */
    .glass {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(0, 39, 61, 0.1);
    }

    /* Hero Carousel Transitions */
    .slide {
      transition: transform 1.2s cubic-bezier(0.25, 1, 0.5, 1), opacity 1.2s ease;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      z-index: 10;
      transform: scale(1.1);
    }
    .slide.active {
      opacity: 1;
      z-index: 20;
      transform: scale(1);
    }

    /* Parallax */
    .parallax {
      background-attachment: fixed;
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
    }

    /* --- IMPROVED FOOTER ANIMATION --- */
    .animation-container {
      width: 100%;
      height: 200px;
      position: relative;
      /* Move footer up to overlap with the bottom of the animation */
      margin-bottom: -35px;
      /* Transparent background so body light bg shows at top, footer dark bg shows at bottom */
      background: transparent;
      z-index: 10;
      pointer-events: none; /* Allow clicks to pass through */
    }

    .car {
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }

    .car-left-to-right {
      animation-name: moveLeftToRight;
    }

    .car-right-to-left {
      animation-name: moveRightToLeft;
    }

    @keyframes moveLeftToRight {
      from { transform: translateX(-150px); }
      to { transform: translateX(calc(100vw + 150px)); }
    }

    @keyframes moveRightToLeft {
      from { transform: translateX(calc(100vw + 150px)); }
      to { transform: translateX(-150px); }
    }

    /* --- INFOGRAPHIC STYLES --- */
    .step-connector {
      position: absolute;
      top: 35%;
      left: 0;
      width: 100%;
      height: 2px;
      background: #e2e8f0;
      z-index: 0;
      display: none;
    }
    @media (min-width: 768px) {
      .step-connector { display: block; }
    }
    .step-item:hover .step-icon {
      background-color: #F7C600;
      color: #00273D;
      transform: scale(1.1) rotate(5deg);
      border-color: #F7C600;
    }
    .step-icon {
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    /* Animated dashed line flow */
    .flow-line {
      stroke-dasharray: 10;
      animation: dash 30s linear infinite;
    }
    @keyframes dash {
      to {
        stroke-dashoffset: -1000;
      }
    }

    /* Modal Animation */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
      animation: fadeInUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Navigation Arrows */
    .nav-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 30;
      color: white;
      font-size: 2rem;
      background: rgba(0, 39, 61, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.2);
      width: 50px;
      height: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      cursor: pointer;
      transition: all 0.3s ease;
      backdrop-filter: blur(4px);
    }
    .nav-arrow:hover {
      background: #F7C600;
      color: #00273D;
    }
    .nav-arrow.prev { left: 20px; }
    .nav-arrow.next { right: 20px; }

    /* Custom Scrollbar for Modal */
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.05);
      margin: 10px 0; /* Add margin to top/bottom of track */
      border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #F7C600; /* Primary Color */
      border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #D4AA00; /* Primary Dark */
    }

    /* Fade In On Scroll */
    .fade-in-section {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.8s ease-out, transform 0.8s ease-out;
      will-change: opacity, visibility;
    }
    .fade-in-section.is-visible {
      opacity: 1;
      transform: none;
    }

  </style>
</head>
